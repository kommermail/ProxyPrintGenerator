# One repo, edited on a Windows PC and a Mac. Text is stored with LF line
# endings in the repo; each computer checks files out its own way. This
# keeps the two machines from showing every line as changed.
* text=auto

# Scripts that only one system runs keep that system's line endings.
*.ps1 text eol=crlf
*.sh  text eol=lf

# Never touch these.
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.ttf    binary
*.zip    binary
*.pdf    binary
