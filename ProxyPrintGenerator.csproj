<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target brings in Windows.Data.Pdf for printing. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ProxyPrintGenerator</RootNamespace>
    <AssemblyName>ProxyPrintGenerator</AssemblyName>
    <ApplicationIcon>Assets\Images\app.ico</ApplicationIcon>
    <Version>1.60.0</Version>
    <Product>ProxyPrintGenerator</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Images\*.jpg" />
    <Resource Include="Assets\Images\*.png" />
    <Resource Include="Assets\Images\app.ico" />
  </ItemGroup>

</Project>
