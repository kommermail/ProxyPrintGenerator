<UserControl x:Class="ProxyPrintGenerator.Views.PrintSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ProxyPrintGenerator.Controls"
             xmlns:v="clr-namespace:ProxyPrintGenerator.Views">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="c:OutlinedText">
            <Setter Property="Size" Value="21"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Round color swatches with a gold ring on the chosen one -->
        <Style x:Key="Swatches" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Width="36" Height="36" Margin="1" Background="Transparent">
                                        <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="3"/>
                                        <Ellipse Margin="6" Fill="{Binding Brush}" Stroke="#80000000" StrokeThickness="1"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="#88D49E38"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{StaticResource Gold}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The label's fonts, each showing PROXY in itself -->
        <Style x:Key="FontPicker" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="chip" CornerRadius="8" Margin="0,0,6,6" Padding="10,2,10,4" MinWidth="96"
                                            Background="#40FFF8E8" BorderBrush="#66331F12" BorderThickness="1">
                                        <TextBlock Text="PROXY" FontFamily="{Binding Family}" FontWeight="{Binding Weight}" FontStyle="{Binding Style}"
                                                   FontSize="21" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Background" Value="#90FFF8E8"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="chip" Property="Background" Value="{StaticResource GoldButtonFill}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Nine spots over a little art box: where the label or logo sits -->
        <Style x:Key="SpotPicker" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><UniformGrid Columns="3" Rows="3"/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Width="150" Height="108" CornerRadius="8" Padding="5" Background="#3A10281E" BorderBrush="#66331F12" BorderThickness="1">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="ToolTip" Value="{Binding Label}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="spot" CornerRadius="5" Margin="3" Background="#55FFF8E8" BorderBrush="#66331F12" BorderThickness="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="spot" Property="Background" Value="#AAFFF8E8"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="spot" Property="Background" Value="{StaticResource GoldButtonFill}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel IsEnabled="{Binding CanEditSettings}" Opacity="{Binding SettingsOpacity}">
        <!-- Quality -->
        <c:SpectacularHeader Title="Quality" PipsOnSides="True"/>
        <c:OutlinedText Text="Scale" Style="{StaticResource RowLabel}"/>
        <ListBox Style="{StaticResource Segmented}" ItemsSource="{x:Static v:Choices.Scales}" SelectedValue="{Binding Scale}" Margin="0,4,0,0"/>
        <c:OrnamentCaption Text="Dots per inch" Size="18" Margin="0,4,0,6"/>

        <!-- Cutting guides: one row, two switches -->
        <DockPanel Margin="0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Guides}" Margin="0,0,22,0"
                          AutomationProperties.Name="Show cutting guides">
                    <c:OutlinedText Text="Show" Size="19" Margin="0,0,8,0" VerticalAlignment="Center"/>
                </CheckBox>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ThickGuides}" IsEnabled="{Binding Guides}"
                          AutomationProperties.Name="Thick cutting guides">
                    <c:OutlinedText Text="Thick" Size="19" Margin="0,0,8,0" VerticalAlignment="Center"/>
                </CheckBox>
            </StackPanel>
            <c:OutlinedText Text="Cutting guides" Style="{StaticResource RowLabel}"/>
        </DockPanel>
        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShuffleBeforeRender}">
            <c:OutlinedText Text="Shuffle before rendering" Style="{StaticResource RowLabel}"/>
        </CheckBox>

        <!-- The realism sticker: a foil "WOW!" sticker over the two sliders it
             sells, with Auto for the preset (40% vibrance, 12% midtone lift) -->
        <Grid Margin="10,26,10,10" HorizontalAlignment="Center" MaxWidth="660">
            <Border CornerRadius="14" BorderBrush="White" BorderThickness="3" Padding="46,11,16,11"
                    Background="{StaticResource FoilLinear}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-1.5"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
                <Grid>
                    <c:GlitterOverlay Seed="23"/>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoTone}" Margin="16,0,0,0"
                                  VerticalAlignment="Center" AutomationProperties.Name="Auto vibrance and lift"
                                  ToolTip="Sets 40% vibrance and 12% midtone lift">
                            <TextBlock Text="AUTO" FontFamily="{StaticResource PlaqueFont}" FontWeight="Black" FontSize="17"
                                       Foreground="{StaticResource Ink}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource PlaqueFont}" FontWeight="Bold" FontSize="17"
                                   Foreground="{StaticResource Ink}" VerticalAlignment="Center"><Run Text="Increase your proxy realism with a little "/><Run Text="~vibrance and lift~" FontWeight="Black" Foreground="#7A1C8C"/><Run Text="!"/></TextBlock>
                    </DockPanel>
                </Grid>
            </Border>
            <c:Starburst Width="68" Height="68" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-26,-28,0,0"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <c:Starburst.RenderTransform><RotateTransform Angle="-12"/></c:Starburst.RenderTransform>
            </c:Starburst>
        </Grid>
        <v:SliderRow Label="Vibrance" Minimum="0" Maximum="0.6" Value="{Binding Vibrance}" ValueText="{Binding VibranceText}"/>
        <v:SliderRow Label="Midtone lift" Minimum="0" Maximum="0.35" Value="{Binding MidtoneLift}" ValueText="{Binding MidtoneText}"/>

        <!-- Proxy mark: a PROXY label, a colored border, or the logo -->
        <Expander Style="{StaticResource FoldOut}" Margin="0,14,0,4" AutomationProperties.Name="Proxy mark">
            <Expander.Header>
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Left" Text="Proxy mark" Style="{StaticResource RowLabel}"/>
                    <c:OutlinedText Text="{Binding MarkSummary}" Size="16" VerticalAlignment="Center" TextAlignment="Right"
                                    HorizontalAlignment="Right" Margin="14,0,0,0"/>
                </DockPanel>
            </Expander.Header>
            <DockPanel>
                <v:ProxyMarkPreview DockPanel.Dock="Right" Width="150" Height="209.5" Margin="16,4,0,4" VerticalAlignment="Top"
                                    Mark="{Binding Mark}" ToolTip="How the mark sits on a card"/>
                <StackPanel>
                    <c:OrnamentCaption Size="16" Margin="0,2,0,4" Text="Mark every card as a proxy, so nobody mistakes it for the real thing."/>
                    <ListBox Style="{StaticResource Segmented}" FontSize="14" Margin="0,4,0,8" AutomationProperties.Name="Proxy mark kind"
                             ItemsSource="{x:Static v:Choices.MarkKinds}" SelectedValue="{Binding MarkKind}"/>
                    <DockPanel Margin="0,2" Visibility="{Binding ShowMarkColor, Converter={StaticResource Vis}}">
                        <c:OutlinedText Text="Color" Style="{StaticResource RowLabel}" Width="96"/>
                        <ListBox Style="{StaticResource Swatches}" AutomationProperties.Name="Proxy mark color"
                                 ItemsSource="{x:Static v:Choices.MarkColors}" SelectedValuePath="Hex" SelectedValue="{Binding MarkColor}"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,2" Visibility="{Binding ShowMarkFont, Converter={StaticResource Vis}}">
                        <c:OutlinedText Text="Font" Style="{StaticResource RowLabel}" Width="96" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <ListBox Style="{StaticResource FontPicker}" AutomationProperties.Name="Proxy label font"
                                 ItemsSource="{x:Static v:Choices.MarkFonts}" SelectedValuePath="Value" SelectedValue="{Binding MarkFont}"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,2" Visibility="{Binding ShowMarkPosition, Converter={StaticResource Vis}}">
                        <c:OutlinedText Text="Where" Style="{StaticResource RowLabel}" Width="96" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <ListBox Style="{StaticResource SpotPicker}" HorizontalAlignment="Left" AutomationProperties.Name="Proxy mark position"
                                 ItemsSource="{x:Static v:Choices.MarkPositions}" SelectedValuePath="Value" SelectedValue="{Binding MarkPosition}"/>
                    </DockPanel>
                    <StackPanel Visibility="{Binding ShowMarkBorder, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <c:OutlinedText Text="{Binding MarkBorderText}" Style="{StaticResource RowLabel}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource LeatherButton}" Content="−" Width="38" Click="BorderThinner" AutomationProperties.Name="Thinner border"/>
                                <Button Style="{StaticResource LeatherButton}" Content="+" Width="38" Margin="4,0,0,0" Click="BorderWider" AutomationProperties.Name="Wider border"/>
                            </StackPanel>
                            <c:OutlinedText Text="Border width (mm)" Style="{StaticResource RowLabel}"/>
                        </DockPanel>
                        <c:OrnamentCaption Size="15" Text="3 mm recolors the card's black edge; wider runs into the frame."/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Expander>

        <!-- Paper and printer: the sheet size, and the printer's own reach -->
        <Expander Style="{StaticResource FoldOut}" AutomationProperties.Name="Paper and printer">
            <Expander.Header>
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Left" Text="Paper and printer" Style="{StaticResource RowLabel}"/>
                    <c:OutlinedText Text="{Binding PaperSummary}" Size="16" VerticalAlignment="Center" TextAlignment="Right"
                                    HorizontalAlignment="Right" Margin="14,0,0,0"/>
                </DockPanel>
            </Expander.Header>
            <StackPanel>
                <DockPanel Margin="0,4">
                    <ComboBox DockPanel.Dock="Right" Width="340" FontFamily="{StaticResource FellFont}" FontSize="16" Padding="8,4"
                              ItemsSource="{Binding PaperChoices}" SelectedItem="{Binding Paper}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Paper size"/>
                    <c:OutlinedText Text="Paper size" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <c:OrnamentCaption Size="16" Text="{Binding GridCaption}" Margin="0,2,0,6"/>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FitToPrinter}" AutomationProperties.Name="Fit to my printer">
                    <c:OutlinedText Text="Fit to my printer" Style="{StaticResource RowLabel}"/>
                </CheckBox>
                <StackPanel Visibility="{Binding FitToPrinter, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LeatherButton}" Content="Read again" Margin="8,0,0,0" Click="ReadAgain"
                                ToolTip="Ask the printer's driver again (after changing its settings, say)"/>
                        <ComboBox DockPanel.Dock="Right" Width="340" FontFamily="{StaticResource FellFont}" FontSize="16" Padding="8,4"
                                  ItemsSource="{Binding Printers}" SelectedItem="{Binding FitPrinter}" AutomationProperties.Name="Printer to fit"/>
                        <c:OutlinedText Text="Printer" Style="{StaticResource RowLabel}"/>
                    </DockPanel>
                    <Border CornerRadius="8" Background="#30FFF8E8" Padding="10,6" Margin="0,4,0,4"
                            Visibility="{Binding FitStatus, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding FitStatus}" TextWrapping="Wrap" FontFamily="{StaticResource FellFont}" FontSize="16"
                                   Foreground="{StaticResource Ink}"/>
                    </Border>
                </StackPanel>
                <c:OrnamentCaption Size="15" Margin="0,4,0,0"
                                   Text="When you print from the app, your printer is told to use this paper size."/>
            </StackPanel>
        </Expander>

        <!-- Print options: layout fixes most people never need -->
        <Expander Style="{StaticResource FoldOut}" AutomationProperties.Name="Print options">
            <Expander.Header>
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Left" Text="Print options" Style="{StaticResource RowLabel}"/>
                    <c:OutlinedText Text="{Binding PrintOptionsSummary}" Size="16" VerticalAlignment="Center" TextAlignment="Right"
                                    HorizontalAlignment="Right" Margin="14,0,0,0"/>
                </DockPanel>
            </Expander.Header>
            <StackPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BackToBack}">
                    <c:OutlinedText Text="Two sided cards back to back" Style="{StaticResource RowLabel}"/>
                </CheckBox>
                <c:OrnamentCaption Size="16" Visibility="{Binding BackToBack, Converter={StaticResource Vis}}"
                                   Text="One sided cards come first. Two sided cards follow as front and back pages that print double sided, so each card is one piece."/>
                <DockPanel Margin="0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <c:OutlinedText Text="{Binding ShiftUpText}" Style="{StaticResource RowLabel}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource LeatherButton}" Content="−" Width="38" Click="ShiftDown"/>
                        <Button Style="{StaticResource LeatherButton}" Content="+" Width="38" Margin="4,0,0,0" Click="ShiftUp"/>
                    </StackPanel>
                    <c:OutlinedText Text="Shift up (mm)" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <c:OutlinedText Text="{Binding ExtraGapText}" Style="{StaticResource RowLabel}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource LeatherButton}" Content="−" Width="38" Click="GapDown"/>
                        <Button Style="{StaticResource LeatherButton}" Content="+" Width="38" Margin="4,0,0,0" Click="GapUp"/>
                    </StackPanel>
                    <c:OutlinedText Text="Extra gap (mm)" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <StackPanel Visibility="{Binding ShowSafeArea, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,4">
                        <ListBox DockPanel.Dock="Right" Width="200" FontSize="15" Style="{StaticResource Segmented}"
                                 ItemsSource="{x:Static v:Choices.SafeAreas}" SelectedValue="{Binding SafeArea}"/>
                        <c:OutlinedText Text="Safe area" Style="{StaticResource RowLabel}"/>
                    </DockPanel>
                    <c:OrnamentCaption Size="16" Visibility="{Binding IsSafeAreaOn, Converter={StaticResource Vis}}"
                                       Text="Cards stay inside the Canon printable area; the gaps shrink a little to fit."/>
                </StackPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MaximizeGap}">
                    <c:OutlinedText Text="Max gap" Style="{StaticResource RowLabel}"/>
                </CheckBox>
                <c:OrnamentCaption Size="16" Text="{Binding ResolvedGapCaption}" Visibility="{Binding MaximizeGap, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Expander>

        <!-- Low ink calibration: per channel boosts for a printer running dry -->
        <Expander Style="{StaticResource FoldOut}" AutomationProperties.Name="Low ink calibration">
            <Expander.Header>
                <DockPanel>
                    <c:OutlinedText DockPanel.Dock="Left" Text="Low ink calibration" Style="{StaticResource RowLabel}"/>
                    <c:OutlinedText Text="{Binding CalibrationSummary}" Size="16" VerticalAlignment="Center" TextAlignment="Right"
                                    HorizontalAlignment="Right" Margin="14,0,0,0"/>
                </DockPanel>
            </Expander.Header>
            <StackPanel>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCalibration}">
                    <c:OutlinedText Text="Use calibration" Style="{StaticResource RowLabel}"/>
                </CheckBox>
                <StackPanel Visibility="{Binding UseCalibration, Converter={StaticResource Vis}}">
                    <v:SliderRow Label="Cyan boost" Minimum="0.8" Maximum="1.6" Value="{Binding CyanBoost}" ValueText="{Binding CyanText}"/>
                    <v:SliderRow Label="Magenta boost" Minimum="0.8" Maximum="1.6" Value="{Binding MagentaBoost}" ValueText="{Binding MagentaText}"/>
                    <v:SliderRow Label="Yellow boost" Minimum="0.8" Maximum="1.6" Value="{Binding YellowBoost}" ValueText="{Binding YellowText}"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Format -->
        <c:SpectacularHeader Title="Format" PipsOnSides="True"/>
        <ListBox Style="{StaticResource Segmented}" ItemsSource="{x:Static v:Choices.Formats}" SelectedValue="{Binding Format}"/>
        <v:SliderRow Label="JPEG quality" Minimum="0.3" Maximum="0.95" Value="{Binding JpegQuality}" ValueText="{Binding JpegQualityText}"
                     Visibility="{Binding IsJpeg, Converter={StaticResource Vis}}" Margin="0,6,0,0"/>
        <c:OrnamentCaption Text="{Binding FormatCaption}" Size="18" Margin="0,6,0,0"/>

        <!-- Finished -->
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
            <c:SpectacularHeader Title="Finished" PipsOnSides="True"/>
            <c:OutlinedText Text="{Binding ResultSummary}" Size="20" Wrap="True"/>
            <c:OutlinedText Text="{Binding ResultBacks}" Size="20" Wrap="True" Visibility="{Binding ResultBacks, Converter={StaticResource Vis}}"/>
            <c:OutlinedText Text="{Binding ResultSize}" Size="20"/>
            <c:OutlinedText Text="{Binding SavedMessage}" Size="19" Wrap="True" Visibility="{Binding SavedMessage, Converter={StaticResource Vis}}"/>
            <TextBlock Text="{Binding ResultWarnings}" Foreground="{StaticResource Warning}" FontSize="15" TextWrapping="Wrap"
                       Visibility="{Binding ResultWarnings, Converter={StaticResource Vis}}"/>
        </StackPanel>
        <TextBox Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource ErrorRed}" FontFamily="{StaticResource FellFont}" FontSize="17" Margin="0,10,0,0"
                 Visibility="{Binding ErrorText, Converter={StaticResource Vis}}"/>
    </StackPanel>
</UserControl>
